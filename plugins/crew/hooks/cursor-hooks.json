{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 ./scripts/session-start.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 ./scripts/persistent-mode.py",
        "timeout": 5,
        "loop_limit": 3
      }
    ]
  }
}
