# Runtime state (created per-project, not part of plugin source)
.crew/
**/.crew/

# Local Claude settings (user-specific permissions)
.claude/settings.local.json

# Linked git worktrees: a worktree's checkout must never be tracked by the parent
# repo (the rest of .claude/, incl. the tracked .claude/CLAUDE.md, stays tracked).
.claude/worktrees/

# Eval workspace
skill-eval-workspace/

# Python
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
